* text=auto eol=lf

# Windows-native scripts keep CRLF; project code and data stay LF for WSL.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary research and publication artifacts must never be line-normalized.
*.gif binary
*.gz binary
*.jpg binary
*.jpeg binary
*.mgz binary
*.nii binary
*.npz binary
*.pdf binary
*.png binary
*.pth binary
*.pt binary
*.zip binary
